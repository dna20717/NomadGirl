// Cloudflare: Worker "nomadgirl" serves start page, game and workshop. The whole address sits behind Cloudflare Access.
// - dist/ (built by `npm run build:web` on every push to main, Workers Builds) as static assets
// - /api/* through worker/index.js: login check (Cloudflare Access) and saving as commits into the repository
// Secret GITHUB_TOKEN is set in the Cloudflare dashboard (Settings › Variables and Secrets), never here.
// POLICY_AUD: audience tag of the Access application (shown on /api/access-info after logging in).
{
  "name": "nomadgirl",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GITHUB_REPO": "dna20717/NomadGirl",
    "BRANCH": "main",
    "DATA_DIR": "projects/nomadgirl",
    "TEAM_DOMAIN": "https://lively-voice-a1ce.cloudflareaccess.com",
    "POLICY_AUD": ""
  }
}
